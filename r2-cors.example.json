[
  {
    "AllowedOrigins": ["http://localhost:3000", "https://your-app-domain.com"],
    "AllowedMethods": ["PUT", "GET", "HEAD"],
    "AllowedHeaders": [
      "Content-Type",
      "Content-Length",
      "If-None-Match",
      "Cache-Control"
    ],
    "ExposeHeaders": ["ETag"],
    "MaxAgeSeconds": 3600
  }
]
