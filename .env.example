# Neon: use the pooled connection URL for the app, and direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CRON_SECRET=
# local (development) or s3 (R2 or B2 private bucket)
STORAGE_DRIVER=local
# Only used by the local development object-storage driver.
DATA_DIR=./data
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional separate origin routed to this app's /f paths; enables inline media.
FILE_BASE_URL=
