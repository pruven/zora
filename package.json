{
  "name": "zora",
  "version": "1.0.0",
  "description": "Small-file sharing with ten-day expiry and a shared storage pool",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "cleanup": "tsx --env-file-if-exists=.env.local scripts/cleanup.ts",
    "prestart": "tsx --env-file-if-exists=.env.local scripts/check-production.ts",
    "reports": "tsx --env-file-if-exists=.env.local scripts/reports.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@better-auth/drizzle-adapter": "^1.7.25",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@pruven/zeke": "^0.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.16.0"
  }
}
